<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="679.2" prefWidth="1424.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Book.BookControlerPage">
   <children>
      <Pane layoutX="68.0" layoutY="274.0" prefHeight="362.0" prefWidth="1281.0" styleClass="my-card" stylesheets="@../css/style.css">
         <children>
            <Label layoutX="24.0" layoutY="24.0" text="New Add All Book">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
         </children></Pane>
      <Label layoutX="68.0" layoutY="38.0" text="Add Your New Book">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <Label layoutX="92.0" layoutY="107.0" text="ISBN Number">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <TextField fx:id="isbn_num" layoutX="92.0" layoutY="133.0" prefHeight="34.0" prefWidth="300.0" promptText="B001" styleClass="my-text-input-field" stylesheets="@../css/style.css" />
      <Label layoutX="414.0" layoutY="107.0" text="Book Title">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <TextField fx:id="book_title" layoutX="414.0" layoutY="133.0" prefHeight="34.0" prefWidth="300.0" promptText="Madoolduwa" styleClass="my-text-input-field" stylesheets="@../css/style.css" />
      <Label layoutX="737.0" layoutY="107.0" text="Author">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <TextField fx:id="author_name" layoutX="735.0" layoutY="133.0" prefHeight="34.0" prefWidth="300.0" promptText="Mr. Martin Wikramasingha" styleClass="my-text-input-field" stylesheets="@../css/style.css" />
      <ComboBox fx:id="category_select" layoutX="90.0" layoutY="211.0" prefHeight="34.0" prefWidth="300.0" promptText="Select" styleClass="my-text-input-field" stylesheets="@../css/style.css" />
      <Label layoutX="90.0" layoutY="185.0" text="Category">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <DatePicker fx:id="pub_year" layoutX="412.0" layoutY="211.0" prefHeight="34.0" prefWidth="300.0" promptText="MM / DD / YYYY" styleClass="date-picker" stylesheets="@../css/style.css" />
      <Label layoutX="412.0" layoutY="185.0" text="Publish Years">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <Label layoutX="734.0" layoutY="185.0" text="Quntity">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <TextField fx:id="qty" layoutX="734.0" layoutY="211.0" prefHeight="34.0" prefWidth="300.0" promptText="25" styleClass="my-text-input-field" stylesheets="@../css/style.css" />
      <Button fx:id="add_btn" layoutX="1207.0" layoutY="211.0" mnemonicParsing="false" onAction="#AddNewBookOnAcction" prefHeight="34.0" prefWidth="124.0" styleClass="my-add-button" stylesheets="@../css/style.css" text="Add New Book" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
      <Button fx:id="clear_btn" layoutX="1071.0" layoutY="211.0" mnemonicParsing="false" onAction="#ClearOnAction" prefHeight="34.0" prefWidth="124.0" styleClass="my-add-button" stylesheets="@../css/style.css" text="Clear" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
      <TableView fx:id="book_table" layoutX="92.0" layoutY="340.0" prefHeight="274.0" prefWidth="1232.0" styleClass="my-table" stylesheets="@../css/style.css">
        <columns>
          <TableColumn prefWidth="75.0" text="ISBN Number" />
          <TableColumn prefWidth="75.0" text="Book Title" />
            <TableColumn prefWidth="75.0" text="Author" />
            <TableColumn prefWidth="75.0" text="Category" />
            <TableColumn prefWidth="75.0" text="Publish Years" />
            <TableColumn prefWidth="75.0" text="Quantity" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</AnchorPane>
